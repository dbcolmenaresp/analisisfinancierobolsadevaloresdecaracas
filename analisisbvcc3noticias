    def _mochila(self):
        try:
            presup = float(self.entry_pres.get().replace(",", ""))
        except ValueError:
            messagebox.showerror("Error", "Presupuesto inválido.")
            return
        per_map = {"1 mes":"1mo","3 meses":"3mo","6 meses":"6mo","1 año":"1y","Todo":"max"}
        periodo = per_map.get(self.combo_moch_per.get(), "1y")
        regs = []
        for tk, sec in TICKERS_BVC.items():
            df = self._descargar(tk, periodo)
            if df.empty or len(df) < 30:
                continue
            r = df["Close"].pct_change().dropna()
            if len(r) < 20 or r.std() == 0:
                continue
            regs.append({"ticker": tk, "sector": sec,
                         "precio": float(df["Close"].iloc[-1]),
                         "sharpe": float(r.mean()/r.std())})
        if not regs:
            messagebox.showwarning("Datos", "Sin datos suficientes.")
            return
        dfr = pd.DataFrame(regs)
        dfm = dfr.loc[dfr.groupby("sector")["sharpe"].idxmax()].reset_index(drop=True)
        sel, _ = self._knapsack(dfm["precio"].tolist(), dfm["sharpe"].tolist(), presup)
        for row in self.tree_moch.get_children():
            self.tree_moch.delete(row)
        if not sel:
            messagebox.showinfo("Sin selección", f"Con {presup:,.2f} Bs. no alcanza.")
            return
        elegidas = dfm.iloc[sel]
        for _, r in elegidas.iterrows():
            self.tree_moch.insert("", "end", values=(r["ticker"], r["sector"],
                                                     f"{r['precio']:,.2f}", f"{r['sharpe']:.4f}"))
        costo = elegidas["precio"].sum()
        messagebox.showinfo("Portafolio",
                            f"Costo: {costo:,.2f} Bs.\nRestante: {presup-costo:,.2f} Bs.\n"
                            f"Sectores: {', '.join(elegidas['sector'].unique())}")

    @staticmethod
    def _knapsack(pesos, valores, cap):
        esc = 100
        pi = [int(round(p*esc)) for p in pesos]
        ci = int(round(cap*esc))
        n = len(pesos)
        dp = [[0]*(ci+1) for _ in range(n+1)]
        for i in range(1, n+1):
            for w in range(ci+1):
                dp[i][w] = max(dp[i-1][w],
                               dp[i-1][w-pi[i-1]] + valores[i-1]) if pi[i-1] <= w else dp[i-1][w]
        sel, w = [], ci
        for i in range(n, 0, -1):
            if dp[i][w] != dp[i-1][w]:
                sel.append(i-1); w -= pi[i-1]
        return sel[::-1], dp[n][ci]

    # ----------------------------------------------------------
    # UTILIDADES GENERALES
    # ----------------------------------------------------------
    def _descargar(self, ticker, periodo):
        try:
            d = yf.download(ticker, period=periodo, progress=False, auto_adjust=True)
            if d.empty:
                messagebox.showwarning("Sin datos", f"{ticker} no devolvió datos.")
                return pd.DataFrame()
            if isinstance(d.columns, pd.MultiIndex):
                d.columns = d.columns.get_level_values(0)
            return d
        except Exception as e:
            messagebox.showerror("Error", f"{ticker}: {e}")
            return pd.DataFrame()

    def _mostrar_figura(self, fig, frame):
        for w in frame.winfo_children():
            w.destroy()
        canvas = FigureCanvasTkAgg(fig, master=frame)
        canvas.draw()
        NavigationToolbar2Tk(canvas, frame).update()
        canvas.get_tk_widget().pack(fill="both", expand=True)


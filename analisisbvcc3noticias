            f"Sentimiento promedio: {sentimiento_prom:+.3f}  "
            f"({len(scores)} noticias analizadas)\n"
            f"→ SEÑAL COMPUESTA: {señal['etiqueta']} (score={señal['score']})"
        )
        self.text_resumen.delete("1.0", "end")
        self.text_resumen.insert("1.0", resumen)

    def _graficar_ticker_con_indicadores(self, ticker, df, periodo_nombre, sentimiento_prom):
        fig = Figure(figsize=(10, 6.5), dpi=100)
        ax = fig.add_subplot(211)
        ax2 = fig.add_subplot(212)

        # Panel superior: precio + Bollinger + MM
        ax.plot(df.index, df["Close"], label="Cierre", color="steelblue", lw=1.4)
        ax.plot(df.index, df["BB_Upper"], color="gray", ls="--", alpha=0.6, label="BB Sup")
        ax.plot(df.index, df["BB_Lower"], color="gray", ls="--", alpha=0.6, label="BB Inf")
        ax.fill_between(df.index, df["BB_Lower"], df["BB_Upper"], color="gray", alpha=0.08)

        # Proyección lineal (como referencia)
        idx = np.arange(len(df))
        pend, inter, r_val, _, _ = stats.linregress(idx, df["Close"])
        dias_fut = 30
        fut_idx = np.arange(len(df), len(df)+dias_fut)
        fut_fechas = pd.bdate_range(df.index[-1]+timedelta(days=1), periods=dias_fut)
        ax.plot(fut_fechas, inter + pend*fut_idx, color="purple", ls="-.",
                lw=1.8, label="Proyección 30d")

        ax.set_title(f"{ticker} — Precio, Bollinger y proyección ({periodo_nombre})", fontsize=10)
        ax.legend(fontsize=7, loc="upper left")
        ax.grid(alpha=0.25)

        # Panel inferior: RSI y MACD en ejes secundarios
        ax2.plot(df.index, df["RSI_14"], color="orange", lw=1.2, label="RSI(14)")
        ax2.axhline(70, color="red", ls=":", alpha=0.6)
        ax2.axhline(30, color="green", ls=":", alpha=0.6)
        ax2.set_ylabel("RSI", color="orange")
        ax2.tick_params(axis="y", labelcolor="orange")
        ax2.grid(alpha=0.2)

        ax3 = ax2.twinx()
        ax3.bar(df.index, df["MACD_Hist"], color="gray", alpha=0.4, width=1.0, label="MACD Hist")
        ax3.plot(df.index, df["MACD"], color="blue", lw=0.9, alpha=0.7, label="MACD")
        ax3.plot(df.index, df["MACD_Signal"], color="red", lw=0.9, alpha=0.7, label="Señal")
        ax3.set_ylabel("MACD", color="blue")
        ax3.tick_params(axis="y", labelcolor="blue")

        # Líneas de sentimiento como texto en el gráfico
        ax2.text(0.01, 0.95, f"Sentimiento noticias: {sentimiento_prom:+.2f}",
                 transform=ax2.transAxes, fontsize=8, va="top",
                 bbox=dict(boxstyle="round", facecolor="white", alpha=0.8))

        fig.tight_layout()
        self._mostrar_figura(fig, self.frame_grafico)

    def _obtener_noticias(self, ticker, usar_finbert):
        try:
            items = yf.Ticker(ticker).news or []
        except Exception:
            return [], []

        titulares, scores = [], []
        for item in items[:15]:  # máximo 15 noticias
            titulo = extraer_titular(item)
            if not titulo:
                continue
            titulares.append(titulo)
        if titulares:
            scores = analizar_sentimiento_titulares(titulares, usar_finbert)
        return titulares, scores


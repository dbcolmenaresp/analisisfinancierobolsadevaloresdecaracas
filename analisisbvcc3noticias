# ============================================================
# UTILIDADES DE NOTICIAS
# ============================================================
def extraer_titular(item: dict) -> str:
    """
    Extrae el título de una noticia de yfinance manejando ambos esquemas:
    - Legacy: item["title"] (versiones < 1.8)
    - Nuevo:  item["content"]["title"] (yfinance 1.8+)
    Referencia: yfinance 1.8.0 anida los campos bajo "content"[reference:1].
    """
    if "content" in item and isinstance(item["content"], dict):
        return item["content"].get("title", "").strip()
    return item.get("title", "").strip()

def extraer_fecha(item: dict) -> datetime | None:
    """Devuelve la fecha de publicación de una noticia de yfinance."""
    try:
        if "content" in item and isinstance(item["content"], dict):
            pub = item["content"].get("pubDate")
            if pub:
                return pd.to_datetime(pub).to_pydatetime()
        ts = item.get("providerPublishTime")
        if ts:
            return datetime.fromtimestamp(ts)
    except Exception:
        pass
    return None

def analizar_sentimiento_titulares(titulares: list[str], usar_finbert: bool = False) -> list[float]:
    """
    Devuelve una lista de scores de sentimiento en [-1, 1] para cada titular.
    Si usar_finbert=True, emplea ProsusAI/finbert (requiere transformers+torch).
    Si no, usa VADER (rápido y sin dependencias pesadas).
    """
    if usar_finbert:
        try:
            from transformers import pipeline
            clasificador = pipeline("text-classification", model="ProsusAI/finbert")
            scores = []
            for t in titulares:
                res = clasificador(t, truncation=True, max_length=128)[0]
                etiqueta, conf = res["label"].lower(), res["score"]
                if "positive" in etiqueta:
                    scores.append(conf)
                elif "negative" in etiqueta:
                    scores.append(-conf)
                else:
                    scores.append(0.0)
            return scores
        except Exception as e:
            print(f"⚠️ FinBERT no disponible ({e}). Se usará VADER.")
            # Fallback a VADER

    # VADER por defecto
    return [VADER.polarity_scores(t)["compound"] for t in titulares]

# ============================================================
# INDICADORES TÉCNICOS
# ============================================================
def calcular_indicadores(df: pd.DataFrame) -> pd.DataFrame:
    """
    Añade columnas de indicadores técnicos al DataFrame OHLCV.
    Usa la librería 'rhoa' para RSI, MACD, Bollinger y ADX.
    ATR se calcula manualmente (Wilder) para mayor control.
    """
    df = df.copy()
    close = df["Close"]

    # RSI (14)
    df["RSI_14"] = close.rhoa.indicators.rsi(window_size=14)

    # MACD (12, 26, 9)
    macd_data = close.rhoa.indicators.macd()
    df["MACD"] = macd_data["macd"]
    df["MACD_Signal"] = macd_data["signal"]
    df["MACD_Hist"] = df["MACD"] - df["MACD_Signal"]

    # Bandas de Bollinger (20, 2)
    bb = close.rhoa.indicators.bollinger_bands(window_size=20, num_std=2.0)
    df["BB_Upper"] = bb["upper_band"]
    df["BB_Lower"] = bb["lower_band"]
    df["BB_Mid"] = (df["BB_Upper"] + df["BB_Lower"]) / 2

    # ADX (14) — requiere High, Low, Close
    try:
        df["ADX_14"] = df.rhoa.indicators.adx(window_size=14)
    except Exception:
        df["ADX_14"] = np.nan

    # ATR (14) — cálculo manual (Wilder smoothing)
    high, low, close_prev = df["High"], df["Low"], df["Close"].shift(1)
    tr = pd.concat([high - low,
                    (high - close_prev).abs(),
                    (low - close_prev).abs()], axis=1).max(axis=1)
    df["ATR_14"] = tr.ewm(alpha=1/14, adjust=False).mean()

    return df

def señal_compuesta(df: pd.DataFrame, sentimiento_prom: float = 0.0) -> dict:
    """
    Combina tendencia (pendiente), momentum (RSI, MACD) y sentimiento
    en una señal discreta. Devuelve un dict con el score y la etiqueta.
    """
    if df.empty or len(df) < 50:
        return {"score": 0, "etiqueta": "Datos insuficientes"}

    ultimo = df.iloc[-1]
    score = 0

    # 1. Tendencia: pendiente de los últimos 50 días
    idx = np.arange(len(df.tail(50)))
    pendiente, _, _, _, _ = stats.linregress(idx, df["Close"].tail(50).values)
    if pendiente > 0:
        score += 1
    elif pendiente < 0:
        score -= 1

    # 2. RSI
    rsi = ultimo.get("RSI_14", np.nan)
    if pd.notna(rsi):
        if rsi < 30:
            score += 1   # sobreventa → posible rebote
        elif rsi > 70:
            score -= 1   # sobrecompra → posible corrección

    # 3. MACD
    if ultimo.get("MACD_Hist", 0) > 0:
        score += 1
    elif ultimo.get("MACD_Hist", 0) < 0:
        score -= 1

    # 4. Sentimiento de noticias
    if sentimiento_prom > 0.15:
        score += 1
    elif sentimiento_prom < -0.15:
        score -= 1

    etiqueta = ("Alcista fuerte" if score >= 3 else
                "Alcista" if score >= 1 else
                "Bajista fuerte" if score <= -3 else
                "Bajista" if score <= -1 else "Neutral")

    return {"score": score, "etiqueta": etiqueta}

